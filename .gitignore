node_modules/
dist/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
*.log
.DS_Store

spec/captures/raw/
Specs/

# Local Claude Code settings
.claude/settings.local.json

# Test-only keys, generated on demand by lite/scripts/gen-bench-fixtures.mjs
lite/src/bench/fixtures.generated.ts

# Operator config and its compiled form (lite/openpurr.config.example.yaml is the template)
lite/openpurr.config.yaml
lite/src/config.generated.json

# Per-deployment wrangler config, written by lite/scripts/deploy-config.mjs
lite/wrangler.deploy.json

# Database exports from `pnpm db:backup`: customer data, never commit them
lite/backups/

# The Standard edition binary, when built in place
standard/openpurr

# The dashboard, copied from lite/office-ui at build time (go generate ./internal/officeui)
standard/internal/officeui/files/*
!standard/internal/officeui/files/.gitkeep

# OpenTofu / Terraform working files and per-deployment variables (infra/gcp/examples has the template)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!infra/**/examples/*.tfvars
.terraform.lock.hcl
