---
// The new-app page in each language other than English: /de/add-in-app-purchases/, …
import Start from "../../components/Start.astro";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<Start locale={locale} />
