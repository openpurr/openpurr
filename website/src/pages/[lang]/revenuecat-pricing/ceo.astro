---
// The CEO-on-X page in each language other than English: /de/revenuecat-pricing/ceo/, …
import CeoPosts from "../../../components/CeoPosts.astro";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<CeoPosts locale={locale} />
