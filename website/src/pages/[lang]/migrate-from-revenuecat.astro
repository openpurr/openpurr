---
// The migration page in each language other than English: /de/migrate-from-revenuecat/, …
import Migrate from "../../components/Migrate.astro";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<Migrate locale={locale} />
