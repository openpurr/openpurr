---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found - openpurr">
  <section class="nf">
    <div class="wrap">
      <img src="/mark.png" alt="" width="96" height="96" />
      <h1>Nothing here</h1>
      <p class="lede">The cat knocked this page off the table.</p>
      <a class="btn btn-primary" href="/">Back home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    padding: 120px 0;
  }
  .nf img {
    margin: 0 auto 24px;
  }
  .nf .lede {
    margin: 0 auto 28px;
  }
</style>
