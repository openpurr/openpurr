---
// "Where your 1% goes": what RevenueCat's revenue share pays for, as an interactive estimate. Pick a
// monthly revenue; the page shows your yearly fee, what the servers for an app your size cost on
// Cloudflare (the savings model in ../savings.ts), and how the rest splits across RevenueCat's
// teams by job function (../one-percent.ts). No people are named, and no one's pay is shown: teams
// only, from public figures, all labelled as estimates. English only for now.
//
// Without JavaScript the figures for the initial revenue still show; the slider and motion need it.
import Base from "../layouts/Base.astro";
import { REPO_URL } from "../consts";
import { openpurrCost, revenueCatCost, RC } from "../savings";
import {
  engineerDayCost,
  FUNDING_USD,
  HEADCOUNT,
  INVESTOR_OWNERSHIP,
  INVESTORS,
  REVENUE_2025,
  ROUNDS,
  VALUATION_2025,
  LOADED,
  shareOf,
  SOURCES,
  SOURCES_CHECKED,
  TEAMS,
  teamCost,
} from "../one-percent";

const SLIDER = { min: 2_500, max: 250_000, initial: 25_000 };
const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
const money = (n: number) => usd.format(Math.round(n));
const k = (n: number) => `$${Math.round(n / 1000)}K`;
const pos = (v: number) => Math.log(v / SLIDER.min) / Math.log(SLIDER.max / SLIDER.min);

// The initial figures, for the first paint and for readers without JavaScript.
const fee = revenueCatCost(SLIDER.initial) * 12;
const infra = openpurrCost(SLIDER.initial).cost * 12;
const rest = fee - infra;
const checked = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(SOURCES_CHECKED));
const model = {
  teams: TEAMS.map((t) => ({ key: t.key, share: shareOf(t) })),
  engineerDay: engineerDayCost(),
  investors: INVESTOR_OWNERSHIP,
  slider: SLIDER,
};
const maxShare = Math.max(...TEAMS.map(shareOf));
---

<Base
  title="Where your 1% goes · openpurr"
  description="RevenueCat takes 1% of your revenue. The servers behind your app cost a rounding error. See what the rest pays for: payroll, sales, and venture investors."
>
  <article class="onepct" data-model={JSON.stringify(model)}>
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">Where your 1% goes</span>
        <h1>You're not paying for servers. <span class="accent">You're paying for a ${VALUATION_2025 / 1e6} million company.</span></h1>
        <p class="lede">
          RevenueCat takes 1% of all your tracked revenue once you pass {money(RC.threshold)} a month, and the bill grows every time
          you do. The servers behind your app cost a rounding error. The rest pays for the company: its
          payroll, its sales team, and its investors' return.
        </p>
      </div>
    </section>

    <section class="calc-section">
      <div class="wrap">
        <div class="calc card">
          <label class="rev" for="rev">
            <span>Your app's monthly revenue</span>
            <output data-out="revenue">{money(SLIDER.initial)}</output>
          </label>
          <input id="rev" type="range" min="0" max="1000" step="1" value={Math.round(1000 * pos(SLIDER.initial))} aria-describedby="fee-line" />

          <div class="fee" id="fee-line">
            <div>
              <span class="k">RevenueCat takes</span>
              <strong data-out="fee">{money(fee)}</strong><span class="per">a year</span>
            </div>
            <div>
              <span class="k">The servers actually cost</span>
              <strong class="ok" data-out="infra">{money(infra)}</strong><span class="per">a year</span>
            </div>
          </div>

          <div class="stack" role="img" aria-label="Your yearly fee, split into servers and RevenueCat's teams">
            <i class="seg infra" data-seg="infra" style={`flex-grow:${Math.max(infra / fee, 0.004)}`}></i>
            {TEAMS.map((t, i) => <i class={`seg c${i}`} data-seg={t.key} style={`flex-grow:${(rest / fee) * shareOf(t)}`} title={t.name}></i>)}
          </div>
          <p class="stack-note">
            <span class="dot infra"></span> Servers: <b data-out="infraPct">{((infra / fee) * 100).toFixed(1)}%</b>. Everything else,{" "}
            <b data-out="restPct">{((rest / fee) * 100).toFixed(1)}%</b>, pays for their teams:
          </p>

          <ul class="teams">
            {
              TEAMS.map((t, i) => (
                <li>
                  <div class="row">
                    <span class={`dot c${i}`} />
                    <span class="name">{t.name}</span>
                    <span class="amt" data-out={`team-${t.key}`}>
                      {money(rest * shareOf(t))}
                    </span>
                  </div>
                  <div class="bar">
                    <i class={`c${i}`} data-bar={t.key} style={`transform:scaleX(${shareOf(t) / maxShare})`} />
                  </div>
                  <span class="meta">
                    About {t.people} people · typical salary {k(t.salary)}
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="owners">
            <h3>And more than half of it builds someone else's exit</h3>
            <div class="own-bar" role="img" aria-label={`Venture investors own about ${Math.round(INVESTOR_OWNERSHIP * 100)}% of RevenueCat, our estimate`}>
              <i class="vc" data-own style={`transform:scaleX(${INVESTOR_OWNERSHIP})`}></i>
              <span class="own-l">Venture investors · about {Math.round(INVESTOR_OWNERSHIP * 100)}%</span>
              <span class="own-r">Founders and employees</span>
            </div>
            <p>
              Venture investors have put about ${FUNDING_USD / 1e6} million into RevenueCat across five rounds, and by the
              reported valuations they own more than half of it. They don't need a cut of each payment. Every fee you pay makes the
              company they own worth more, and they collect when it sells. In ownership terms, about <b data-out="vc">{money(fee * INVESTOR_OWNERSHIP)}</b>{" "}
              of what you pay each year is building their return.
            </p>
            <ul class="investors" aria-label="RevenueCat's investors">
              {INVESTORS.map((n) => <li>{n}</li>)}
            </ul>
          </div>

          <p class="punch">
            Your 1% buys about <b data-out="days">{Math.round(rest / engineerDayCost())}</b> engineer-days a year at RevenueCat. Running
            the same job yourself costs <b data-out="infra2">{money(infra)}</b>. <strong>Keep the other <span data-out="keep">{money(fee - infra)}</span>.</strong>
          </p>
        </div>

        <div class="cta">
          <a class="btn btn-primary" href="/#savings">Keep your 1% →</a>
          <a class="btn btn-ghost" href={REPO_URL}>openpurr on GitHub</a>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap narrow">
        <h2>Yes, they do more</h2>
        <p>
          RevenueCat builds more than a purchase backend: paywalls, experiments, integrations, a support line. If you use all of
          it, maybe it's worth it to you. If what you need is purchases validated and subscriptions kept current, you're handing
          over a share of everything you'll ever earn for a job that runs on a few dollars of servers a month.
        </p>

        <h2>How we estimate this</h2>
        <ul class="method">
          <li>
            <b>Your fee:</b> RevenueCat's Pro plan list price, 1% of monthly tracked revenue from {money(RC.threshold)}. Large
            accounts can negotiate other pricing.
          </li>
          <li>
            <b>Servers:</b> what openpurr Lite costs on Cloudflare for an app with that revenue, the same model as our <a
              href="/#savings">savings calculator</a>. RevenueCat's own hosting costs aren't public; this is what the job costs
            when you run it yourself.
          </li>
          <li>
            <b>Teams:</b> job functions, not people. We assume {HEADCOUNT.used} people (public estimates range from {HEADCOUNT.low}
            to {HEADCOUNT.high}) and split them across functions ourselves. Salaries come from RevenueCat's public job postings,
            which list pay; each team's cost is people × salary × {LOADED} for taxes, benefits and equipment, without equity.
            The part of your fee that isn't servers is split in proportion to those costs.
          </li>
          <li>
            <b>Investors:</b> five rounds from 2018 to 2025, about ${FUNDING_USD / 1e6} million in all. Ownership isn't public, so we
            compound it from the reported valuations: each round's investors get the amount divided by the post-money valuation, and
            everyone before is diluted by the same share. That gives about {Math.round(INVESTOR_OWNERSHIP * 100)}%. Option pools and Y
            Combinator's accelerator stake aren't counted. Their share is of what the company is worth, not a line in its costs,
            which is why it's shown separately. At the 2025 round, the company was reported at about ${REVENUE_2025 / 1e6} million
            in yearly revenue, close to break-even.
            <table class="rounds">
              <thead><tr><th>Round</th><th>Raised</th><th>Valuation</th><th>Led by</th></tr></thead>
              <tbody>
                {ROUNDS.map((r) => (
                  <tr>
                    <td>{r.name}, {r.year}</td>
                    <td>{`$${r.amount / 1e6}M`}</td>
                    <td>{r.post ? `$${r.post / 1e6}M` : "not reported"}</td>
                    <td>{r.lead ?? "not reported"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </li>
          <li><b>Not affiliated:</b> openpurr isn't affiliated with RevenueCat. These are our estimates, not RevenueCat's figures.</li>
        </ul>

        <details class="assumptions">
          <summary>The assumptions, team by team</summary>
          <table>
            <thead><tr><th>Team</th><th>People</th><th>Salary</th><th>Yearly cost</th><th>Salary from</th></tr></thead>
            <tbody>
              {
                TEAMS.map((t) => (
                  <tr>
                    <td>{t.name}</td>
                    <td>{t.people}</td>
                    <td>{k(t.salary)}</td>
                    <td>{`$${(teamCost(t) / 1e6).toFixed(1)}M`}</td>
                    <td class="muted">{t.basis}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </details>

        <h2>Sources</h2>
        <ul class="sources">
          {SOURCES.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
        <p class="muted">Checked on {checked}. Spot something out of date? <a href={`${REPO_URL}/issues`}>Open an issue</a>.</p>
      </div>
    </section>
  </article>
</Base>

<style>
  .onepct {
    --c0: #7050e8;
    --c1: #8d72f0;
    --c2: #a894f5;
    --c3: #5a3dd6;
    --c4: #c2b4f8;
    --c5: #4a2fc0;
    --c6: #b3a2ff;
    --c7: #2f1f8f;
  }
  .hero {
    padding-bottom: 32px;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 820px;
    margin-bottom: 18px;
  }
  .accent {
    color: var(--purple);
  }
  .calc-section {
    padding-top: 0;
  }
  .calc {
    max-width: 860px;
    padding: 32px;
  }
  .rev {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-weight: 600;
    color: var(--muted);
  }
  .rev output {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: 100%;
    margin: 14px 0 26px;
    accent-color: var(--purple);
  }
  .fee {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .fee .k {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .fee strong {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .fee strong.ok {
    color: var(--ok);
  }
  .per {
    margin-inline-start: 6px;
    color: var(--muted);
  }
  .stack {
    display: flex;
    height: 28px;
    border-radius: 8px;
    overflow: hidden;
    margin: 26px 0 10px;
    gap: 2px;
    background: var(--line);
  }
  .seg {
    flex-basis: 0;
    transition: flex-grow 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .seg.infra,
  .dot.infra {
    background: var(--ok);
  }
  .stack-note {
    color: var(--muted);
    margin-bottom: 18px;
  }
  .stack-note b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .teams {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .name {
    font-weight: 600;
    color: var(--ink);
  }
  .amt {
    margin-inline-start: auto;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
    display: inline-block;
  }
  .bar {
    height: 8px;
    background: var(--purple-soft);
    border-radius: 99px;
    margin: 6px 0 4px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    border-radius: 99px;
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global([dir="rtl"]) .bar i {
    transform-origin: right;
  }
  .meta {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .c0 { background: var(--c0); }
  .c1 { background: var(--c1); }
  .c2 { background: var(--c2); }
  .c3 { background: var(--c3); }
  .c4 { background: var(--c4); }
  .c5 { background: var(--c5); }
  .c6 { background: var(--c6); }
  .c7 { background: var(--c7); }
  .owners {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .owners h3 {
    font-size: 1.1rem;
    margin-bottom: 12px;
  }
  .owners p {
    color: var(--text);
    margin-top: 12px;
  }
  .owners b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .own-bar {
    position: relative;
    height: 40px;
    border-radius: 10px;
    background: var(--purple-soft);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .own-bar .vc {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: left;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global([dir="rtl"]) .own-bar .vc {
    transform-origin: right;
  }
  .own-l,
  .own-r {
    position: relative;
    padding: 0 12px;
  }
  .own-l {
    color: var(--bg);
  }
  .own-r {
    color: var(--muted);
  }
  .investors {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .investors li {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 99px;
    background: var(--ink);
    color: var(--bg);
  }
  .rounds {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  .rounds th,
  .rounds td {
    text-align: start;
    padding: 6px 10px;
    border-bottom: 1px solid var(--line);
  }
  .punch strong {
    display: block;
    margin-top: 6px;
    font-size: 1.25rem;
    color: var(--purple);
  }
  .punch {
    margin-top: 24px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--purple-soft);
    color: var(--text);
  }
  .punch b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .narrow {
    max-width: 760px;
  }
  .narrow h2 {
    margin: 36px 0 12px;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .narrow h2:first-child {
    margin-top: 0;
  }
  .narrow p,
  .method li {
    color: var(--text);
    line-height: 1.6;
  }
  .method,
  .sources {
    padding-inline-start: 20px;
    display: grid;
    gap: 8px;
  }
  .assumptions {
    margin-top: 18px;
  }
  .assumptions summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--purple);
  }
  .assumptions table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  .assumptions th,
  .assumptions td {
    text-align: start;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .muted {
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .calc {
      padding: 20px;
    }
    .fee {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seg,
    .bar i {
      transition: none;
    }
  }
</style>

<script>
  import { openpurrCost, revenueCatCost } from "../savings";

  const root = document.querySelector<HTMLElement>(".onepct");
  if (root) {
    const model = JSON.parse(root.dataset.model!) as {
      teams: { key: string; share: number }[];
      engineerDay: number;
      investors: number;
      slider: { min: number; max: number; initial: number };
    };
    const { min, max } = model.slider;
    const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const input = root.querySelector<HTMLInputElement>("#rev")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const maxShare = Math.max(...model.teams.map((t) => t.share));
    const valueAt = (p: number) => {
      const v = min * Math.pow(max / min, p / 1000);
      // Round to a friendly step for the label.
      const step = v < 10_000 ? 100 : v < 100_000 ? 500 : 1000;
      return Math.round(v / step) * step;
    };

    // Numbers glide to their new value instead of jumping.
    const shown = new Map<string, number>();
    const tween = (key: string, to: number, fmt: (n: number) => string) => {
      const el = out(key);
      const from = shown.get(key) ?? to;
      shown.set(key, to);
      if (reduced || from === to) return void (el.textContent = fmt(to));
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.max(0, Math.min(1, (now - start) / 450));
        const e = 1 - Math.pow(1 - t, 3);
        el.textContent = fmt(from + (to - from) * e);
        if (t < 1 && shown.get(key) === to) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const render = (revenue: number) => {
      const fee = revenueCatCost(revenue) * 12;
      const infra = openpurrCost(revenue).cost * 12;
      const rest = fee - infra;
      out("revenue").textContent = usd.format(revenue);
      tween("fee", fee, (n) => usd.format(Math.round(n)));
      tween("infra", infra, (n) => usd.format(Math.round(n)));
      tween("infra2", infra, (n) => usd.format(Math.round(n)));
      tween("days", rest / model.engineerDay, (n) => String(Math.round(n)));
      tween("vc", fee * model.investors, (n) => usd.format(Math.round(n)));
      tween("keep", fee - infra, (n) => usd.format(Math.round(n)));
      out("infraPct").textContent = `${((infra / fee) * 100).toFixed(1)}%`;
      out("restPct").textContent = `${((rest / fee) * 100).toFixed(1)}%`;
      root.querySelector<HTMLElement>('[data-seg="infra"]')!.style.flexGrow = String(Math.max(infra / fee, 0.004));
      for (const t of model.teams) {
        tween(`team-${t.key}`, rest * t.share, (n) => usd.format(Math.round(n)));
        root.querySelector<HTMLElement>(`[data-seg="${t.key}"]`)!.style.flexGrow = String((rest / fee) * t.share);
      }
    };

    input.addEventListener("input", () => render(valueAt(Number(input.value))));
    for (const t of model.teams) shown.set(`team-${t.key}`, 0);

    // On first view, the bars grow in and the revenue sweeps up to the initial value.
    const bars = [...root.querySelectorAll<HTMLElement>("[data-bar]")];
    const target = Number(input.value);
    if (!reduced) {
      for (const b of bars) b.style.transform = "scaleX(0)";
      const own = root.querySelector<HTMLElement>("[data-own]")!;
      own.style.transform = "scaleX(0)";
      const seen = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        for (const t of model.teams) {
          const b = root.querySelector<HTMLElement>(`[data-bar="${t.key}"]`)!;
          b.style.transform = `scaleX(${t.share / maxShare})`;
        }
        own.style.transform = `scaleX(${model.investors})`;
        const start = performance.now();
        const sweep = (now: number) => {
          const p = Math.max(0, Math.min(1, (now - start) / 1400));
          const e = 1 - Math.pow(1 - p, 3);
          input.value = String(Math.round(target * e));
          render(valueAt(Number(input.value)));
          if (p < 1) requestAnimationFrame(sweep);
        };
        input.value = "0";
        requestAnimationFrame(sweep);
      }, { threshold: 0.3 });
      seen.observe(root.querySelector(".calc")!);
    } else {
      render(valueAt(target));
    }
  }
</script>
