---
// The RevenueCat pricing page, "Where your 1% goes", in any of the site's languages
// (/revenuecat-pricing/, /<lang>/revenuecat-pricing/): what RevenueCat's revenue share pays for, as
// an interactive estimate. Pick a monthly revenue; the page shows your yearly fee, what the servers
// for an app your size cost on Cloudflare (the savings model in ../savings.ts), how the rest splits
// across RevenueCat's teams by job function, and who owns the company (../one-percent.ts). No people
// are named and no one's pay is shown: teams only, from public figures, all labelled as estimates.
// The copy is in src/i18n/pricing/.
//
// Without JavaScript the figures for the initial revenue still show; the slider and motion need it.
import Base from "../layouts/Base.astro";
import Receipts from "./Receipts.astro";
import { CEO_PAGE, ISSUES_URL, PRICING_PAGE, REPO_URL } from "../consts";
import xCeo from "../data/x-ceo.json";
import { allLocales, fill, langTag, localePath, type Locale } from "../i18n";
import { tp } from "../i18n/pricing";
import { tc } from "../i18n/ceo";
import { LEVELS, openpurrCost, revenueCatCost, RC } from "../savings";
import {
  FUNDING_USD,
  HEADCOUNT,
  INVESTOR_OWNERSHIP,
  INVESTORS,
  JOB_BOARD,
  LOADED,
  REVENUE_2025,
  ROUNDS,
  shareOf,
  SOURCES,
  SOURCES_CHECKED,
  TEAMS,
  teamCost,
  VALUATION_2025,
  SWAG_POST,
} from "../one-percent";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = tp(locale);
const tag = langTag(locale);
// Western digits everywhere, as the rest of the site uses them.
const nf = (o: Intl.NumberFormatOptions) => new Intl.NumberFormat(`${tag}-u-nu-latn`, o);
const usd = nf({ style: "currency", currency: "USD", maximumFractionDigits: 0 });
const money = (n: number) => usd.format(Math.round(n));
/**
 * "$500 million", "500 Millionen $", "$50 करोड़": the number spelled out the long way, with the dollar
 * sign where the language puts it. (Currency formats only offer the short "500 Mio. $" form.)
 */
const big = (n: number) => {
  const words = nf({ notation: "compact", compactDisplay: "long", maximumFractionDigits: 0 }).format(n);
  const parts = usd.formatToParts(1);
  const symbol = parts.find((x) => x.type === "currency")!.value;
  const at = parts.findIndex((x) => x.type === "currency");
  const num = parts.findIndex((x) => x.type === "integer");
  const gap = parts.slice(Math.min(at, num) + 1, Math.max(at, num)).map((x) => x.value).join("");
  return at < num ? `${symbol}${gap}${words}` : `${words}${gap}${symbol}`;
};
/** "$210K", "$7M", … */
const short = (n: number) => nf({ style: "currency", currency: "USD", notation: "compact", maximumFractionDigits: 1 }).format(n);
const pctOf = (x: number, digits = 0) => nf({ style: "percent", minimumFractionDigits: digits, maximumFractionDigits: digits }).format(x);
const num = (n: number) => nf({ maximumFractionDigits: 1 }).format(n);
const list = (items: string[]) => new Intl.ListFormat(`${tag}-u-nu-latn`, { type: "conjunction" }).format(items);
/** Fills a string's {placeholders}, escaping the copy, for strings rendered as HTML. */
const html = (s: string, vars: Record<string, string>) => fill(s, vars);

const SLIDER = { min: 2_500, max: 250_000, initial: 25_000 };
const pos = (v: number) => Math.log(v / SLIDER.min) / Math.log(SLIDER.max / SLIDER.min);
const homePath = localePath(locale, "/");
const ceoMaxHours = Math.max(...xCeo.perDay.map((d) => d.hours));
const ceoPerDay = nf({ minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(xCeo.posts / xCeo.days);
const pagePath = localePath(locale, PRICING_PAGE);

// The initial figures, for the first paint and for readers without JavaScript.
const fee = revenueCatCost(SLIDER.initial) * 12;
const infra = openpurrCost(SLIDER.initial).cost * 12;
const rest = fee - infra;
const swagDate = new Date(`${SWAG_POST.date}T00:00:00Z`).toLocaleDateString(`${tag}-u-nu-latn`, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const checked = new Date(`${SOURCES_CHECKED}T00:00:00Z`).toLocaleDateString(`${tag}-u-nu-latn`, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const model = {
  teams: TEAMS.map((t) => ({ key: t.key, share: shareOf(t) })),
  investors: INVESTOR_OWNERSHIP,
  slider: SLIDER,
  tag,
};
const maxShare = Math.max(...TEAMS.map(shareOf));
const pct = pctOf(INVESTOR_OWNERSHIP);
const yearly = (m: number) => money(revenueCatCost(m) * 12);
const out = (key: string, value: string) => `<b data-out="${key}">${value}</b>`;

// Answers in plain sentences: shown in the FAQ, and the same text in the FAQPage structured data.
const fi = p.faq.items;
const faq = [
  { q: fi.cost.q, a: fill(fi.cost.a, { threshold: money(RC.threshold), at10k: yearly(10_000), at100k: yearly(100_000), m10k: money(10_000), m100k: money(100_000) }) },
  { q: fi.pays.q, a: fill(fi.pays.a, { servers: money(openpurrCost(25_000).cost * 12), fee: yearly(25_000), m25k: money(25_000), people: num(HEADCOUNT.used) }) },
  { q: fi.owns.q, a: fill(fi.owns.a, { funding: big(FUNDING_USD), investors: list(INVESTORS), pct }) },
  { q: fi.worth.q, a: fill(fi.worth.a, { valuation: big(VALUATION_2025), round: big(50_000_000), revenue: big(REVENUE_2025) }) },
  { q: fi.alternative.q, a: fi.alternative.a },
];

const site = Astro.site!.href.replace(/\/$/, "");
const pageUrl = `${site}${pagePath}`;
const headline = `${p.hero.headline} ${fill(p.hero.headlineAccent, { valuation: big(VALUATION_2025) })}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      headline,
      description: p.meta.description,
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      image: `${site}/og-revenuecat-pricing.png`,
      inLanguage: tag,
      datePublished: SOURCES_CHECKED,
      dateModified: SOURCES_CHECKED,
      author: { "@id": `${site}/#organization` },
      publisher: { "@id": `${site}/#organization` },
      about: [
        { "@type": "Organization", name: "RevenueCat", sameAs: "https://www.revenuecat.com" },
        { "@type": "SoftwareApplication", "@id": `${site}/#software`, name: "openpurr", url: `${site}/` },
      ],
      citation: SOURCES.map((s) => s.url),
    },
    { "@type": "Organization", "@id": `${site}/#organization`, name: "openpurr", url: `${site}/`, logo: `${site}/icon-192.png`, sameAs: [REPO_URL] },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "openpurr", item: `${site}${homePath}` },
        { "@type": "ListItem", position: 2, name: p.hero.crumb, item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      inLanguage: tag,
      mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const enHref = locale === "en" ? undefined : "en";
---

<Base
  locale={locale}
  alternates={allLocales(PRICING_PAGE)}
  title={p.meta.title}
  description={p.meta.description}
  ogType="article"
  ogImage="/og-revenuecat-pricing.png"
  ogImageAlt={p.meta.ogImageAlt}
>
  <script type="application/ld+json" set:html={jsonLdText} />
  <article class="onepct" data-model={JSON.stringify(model)}>
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={homePath}>openpurr</a></li>
            <li aria-current="page">{p.hero.crumb}</li>
          </ol>
        </nav>
        <span class="eyebrow">{p.hero.eyebrow}</span>
        <h1>{p.hero.headline} <span class="accent">{fill(p.hero.headlineAccent, { valuation: big(VALUATION_2025) })}</span></h1>
        <p class="lede">{fill(p.hero.lede, { threshold: money(RC.threshold) })}</p>
        <p class="updated" set:html={fill(p.hero.updated, { date: `<time datetime="${SOURCES_CHECKED}">${checked}</time>` })} />

        <div class="owners">
          <h2>{p.calc.ownersTitle}</h2>
          <p class="owners-punch">{p.calc.ownersPunch}</p>
          <div class="own-bar" role="img" aria-label={fill(p.calc.ownersBarLabel, { pct })}>
            <i class="vc" data-own style={`transform:scaleX(${INVESTOR_OWNERSHIP})`}></i>
            <span class="own-l">{fill(p.calc.ownersInvestors, { pct })}</span>
            <span class="own-r">{p.calc.ownersRest}</span>
          </div>
          <p set:html={html(p.calc.ownersText, { funding: big(FUNDING_USD), vc: out("vc", money(fee * INVESTOR_OWNERSHIP)) })} />
          <ul class="investors" aria-label={p.calc.investorsLabel}>
            {INVESTORS.map((n) => <li>{n}</li>)}
          </ul>
        </div>

        <div class="answer">
          <h2>{p.answer.title}</h2>
          <p set:html={html(p.answer.text, { threshold: money(RC.threshold) })} />
          <div class="table-scroll">
            <table>
              <thead><tr><th scope="col">{p.answer.colRevenue}</th><th scope="col">{p.answer.colFee}</th><th scope="col">{p.answer.colServers}</th></tr></thead>
              <tbody>
                {LEVELS.map((l) => (
                  <tr><th scope="row">{money(l)}</th><td>{money(revenueCatCost(l) * 12)}</td><td>{money(openpurrCost(l).cost * 12)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="calc-section">
      <div class="wrap">
        <div class="calc card">
          <label class="rev" for="rev">
            <span>{p.calc.revenue}</span>
            <output data-out="revenue">{money(SLIDER.initial)}</output>
          </label>
          <input id="rev" type="range" min="0" max="1000" step="1" value={Math.round(1000 * pos(SLIDER.initial))} aria-describedby="fee-line" />

          <div class="fee" id="fee-line">
            <div>
              <span class="k">{p.calc.fee}</span>
              <strong data-out="fee">{money(fee)}</strong><span class="per">{p.calc.perYear}</span>
            </div>
            <div>
              <span class="k">{p.calc.servers}</span>
              <strong class="ok" data-out="infra">{money(infra)}</strong><span class="per">{p.calc.perYear}</span>
            </div>
          </div>

          <div class="stack" role="img" aria-label={p.calc.stackLabel}>
            <i class="seg infra" data-seg="infra" style={`flex-grow:${Math.max(infra / fee, 0.004)}`}></i>
            {TEAMS.map((t, i) => <i class={`seg c${i}`} data-seg={t.key} style={`flex-grow:${(rest / fee) * shareOf(t)}`} title={p.teams[t.key as keyof typeof p.teams].name}></i>)}
          </div>
          <p class="stack-note">
            <span class="dot infra"></span>{" "}
            <Fragment set:html={html(p.calc.stackNote, { servers: out("infraPct", pctOf(infra / fee, 1)), rest: out("restPct", pctOf(rest / fee, 1)) })} />
          </p>

          <ul class="teams">
            {
              TEAMS.map((t, i) => (
                <li>
                  <div class="row">
                    <span class={`dot c${i}`} />
                    <span class="name">{p.teams[t.key as keyof typeof p.teams].name}</span>
                    <span class="amt" data-out={`team-${t.key}`}>
                      {money(rest * shareOf(t))}
                    </span>
                  </div>
                  <div class="bar">
                    <i class={`c${i}`} data-bar={t.key} style={`transform:scaleX(${shareOf(t) / maxShare})`} />
                  </div>
                  <span class="meta">{fill(p.calc.teamMeta, { people: num(t.people), salary: short(t.salary) })}</span>
                </li>
              ))
            }
          </ul>


          <div class="extras">
            <figure class="extra extra-swag">
              <img class="swag-photo" src="/revenuecat-skateboard.jpg" width="371" height="700" alt={p.calc.swagPhotoAlt} loading="lazy" decoding="async" />
              <div class="swag-body">
                <p class="extra-title">{p.calc.swag}</p>
                <img class="swag-tweet" src="/revenuecat-skateboard-post.jpg" width="900" height="340" alt={p.calc.swagPostAlt} loading="lazy" decoding="async" />
                <figcaption set:html={html(p.calc.swagCaption, { date: swagDate, link: `<a href="${SWAG_POST.url}" rel="nofollow noopener">${p.calc.swagLink}</a>` })} />
              </div>
            </figure>
            <a class="extra extra-ceo" href={localePath(locale, CEO_PAGE)}>
              <span class="ceo-num">{ceoPerDay}</span>
              <span class="ceo-unit">{tc(locale).stats.perDay}</span>
              <span class="ceo-cal" aria-hidden="true">
                {xCeo.perDay.map((d) => <i class={`h${Math.min(4, Math.ceil((d.hours / ceoMaxHours) * 4))}`} />)}
              </span>
              <span class="extra-title">{fill(p.calc.ceoLink, { perDay: ceoPerDay })}</span>
              <span class="ceo-more">{p.calc.ceoLinkLabel}</span>
            </a>
          </div>
          <p class="punch">
            <Fragment set:html={html(p.calc.punch, { infra: out("infra2", money(infra)) })} />{" "}
            <strong set:html={html(p.calc.keep, { keep: `<span data-out="keep">${money(fee - infra)}</span>` })} />
          </p>

          <div class="receipts-block">
            <h3 class="receipts-title">{p.receipts.title}</h3>
            <Receipts locale={locale} />
          </div>
        </div>

        <div class="cta">
          <a class="btn btn-primary" href={`${homePath}#savings`}>{p.calc.ctaKeep}</a>
          <a class="btn btn-ghost" href={REPO_URL}>{p.calc.ctaGithub}</a>
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="wrap narrow">
        <h2>{p.faq.title}</h2>
        <div class="faq">
          {faq.map(({ q, a }) => (
            <details>
              <summary><h3>{q}</h3></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap narrow">
        <h2>{p.more.title}</h2>
        <p>{p.more.text}</p>

        <h2>{p.method.title}</h2>
        <ul class="method">
          <li set:html={html(p.method.fee, { threshold: money(RC.threshold) })} />
          <li set:html={html(p.method.servers, { calculator: `<a href="${homePath}#savings">${p.method.calculatorLink}</a>` })} />
          <li set:html={html(p.method.teams, { used: num(HEADCOUNT.used), low: num(HEADCOUNT.low), high: num(HEADCOUNT.high), loaded: num(LOADED) })} />
          <li set:html={html(p.method.split, { date: checked, open: num(JOB_BOARD.open), gtm: num(JOB_BOARD.gtm), eng: num(JOB_BOARD.coreEngineering) })} />
          <li>
            <Fragment set:html={html(p.method.investors, { funding: big(FUNDING_USD), pct, revenue: big(REVENUE_2025) })} />
            <div class="table-scroll">
            <table class="rounds">
              <thead><tr><th>{p.method.colRound}</th><th>{p.method.colRaised}</th><th>{p.method.colValuation}</th><th>{p.method.colLead}</th></tr></thead>
              <tbody>
                {ROUNDS.map((r) => (
                  <tr>
                    <td>{r.name}, {r.year}</td>
                    <td>{short(r.amount)}</td>
                    <td>{r.post ? short(r.post) : p.method.notReported}</td>
                    <td>{r.lead ?? p.method.notReported}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
          </li>
          <li set:html={p.method.affiliation} />
        </ul>

        <details class="assumptions">
          <summary>{p.method.assumptions}</summary>
          <div class="table-scroll">
          <table>
            <thead><tr><th>{p.method.colTeam}</th><th>{p.method.colPeople}</th><th>{p.method.colSalary}</th><th>{p.method.colCost}</th><th>{p.method.colBasis}</th></tr></thead>
            <tbody>
              {
                TEAMS.map((t) => (
                  <tr>
                    <td>{p.teams[t.key as keyof typeof p.teams].name}</td>
                    <td>{num(t.people)}</td>
                    <td>{short(t.salary)}</td>
                    <td>{short(teamCost(t))}</td>
                    <td class="muted">{p.teams[t.key as keyof typeof p.teams].basis}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          </div>
        </details>

        <h2>{p.sources.title}</h2>
        <ul class="sources">
          {SOURCES.map((s, i) => <li><a href={s.url} hreflang="en">{p.sources.items[i]}</a></li>)}
        </ul>
        <p class="muted" set:html={html(p.sources.checked, { date: checked, issue: `<a href="${ISSUES_URL}">${p.sources.issueLink}</a>` })} />
      </div>
    </section>
  </article>
</Base>

<style>
  .onepct {
    --c0: #7050e8;
    --c1: #8d72f0;
    --c2: #a894f5;
    --c3: #5a3dd6;
    --c4: #c2b4f8;
    --c5: #4a2fc0;
    --c6: #b3a2ff;
    --c7: #2f1f8f;
  }
  .hero {
    padding-bottom: 32px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: "/";
    margin-inline-end: 6px;
    opacity: 0.6;
  }
  .crumbs a {
    color: inherit;
  }
  .updated {
    margin: 16px 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .answer {
    margin-top: 32px;
    max-width: 760px;
    padding: 22px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .answer h2 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  .answer p {
    color: var(--text);
  }
  .answer table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }
  .answer th,
  .answer td {
    text-align: end;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
  }
  .answer th:first-child {
    text-align: start;
  }
  .answer td:last-child {
    color: var(--ok);
    font-weight: 600;
  }
  .faq details {
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
  }
  .faq summary h3 {
    display: inline;
    font-size: 1.05rem;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+";
    float: inline-end;
    color: var(--purple);
    font-weight: 700;
  }
  .faq details[open] summary::after {
    content: "–";
  }
  .faq p {
    margin-top: 10px;
    color: var(--text);
    line-height: 1.6;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 820px;
    margin-bottom: 18px;
  }
  .accent {
    color: var(--purple);
  }
  .calc-section {
    padding-top: 0;
  }
  .calc {
    max-width: 860px;
    padding: 32px;
  }
  .rev {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-weight: 600;
    color: var(--muted);
  }
  .rev output {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: 100%;
    margin: 14px 0 26px;
    accent-color: var(--purple);
  }
  .fee {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .fee .k {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .fee strong {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .fee strong.ok {
    color: var(--ok);
  }
  .per {
    margin-inline-start: 6px;
    color: var(--muted);
  }
  .stack {
    display: flex;
    height: 28px;
    border-radius: 8px;
    overflow: hidden;
    margin: 26px 0 10px;
    gap: 2px;
    background: var(--line);
  }
  .seg {
    flex-basis: 0;
    transition: flex-grow 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .seg.infra,
  .dot.infra {
    background: var(--ok);
  }
  .stack-note {
    color: var(--muted);
    margin-bottom: 18px;
  }
  .stack-note b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .teams {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .name {
    font-weight: 600;
    color: var(--ink);
  }
  .amt {
    margin-inline-start: auto;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
    display: inline-block;
  }
  .bar {
    height: 8px;
    background: var(--purple-soft);
    border-radius: 99px;
    margin: 6px 0 4px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    border-radius: 99px;
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global([dir="rtl"]) .bar i {
