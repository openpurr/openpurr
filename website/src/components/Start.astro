---
// "Add in-app purchases" (/add-in-app-purchases/, /<lang>/add-in-app-purchases/): for developers who
// haven't added purchases to their app yet. Start without a revenue share: a growth calculator for
// what 1% adds up to over three years (the savings model in ../savings.ts), what that money buys
// instead (Receipts), how setup works, what's included, and an FAQ. The copy is in src/i18n/start/.
//
// Without JavaScript the figures for the initial revenue still show; the slider needs it.
import Base from "../layouts/Base.astro";
import Receipts from "./Receipts.astro";
import SdkSnippet from "./SdkSnippet.astro";
import { PRICING_PAGE, REPO_URL, START_PAGE } from "../consts";
import { allLocales, fill, langTag, localePath, type Locale } from "../i18n";
import { ts } from "../i18n/start";
import { openpurrCost, RC, revenueCatCost } from "../savings";
import agentLogos from "../agent-logos.json";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = ts(locale);
const tag = langTag(locale);
const nf = (o: Intl.NumberFormatOptions) => new Intl.NumberFormat(`${tag}-u-nu-latn`, o);
const usd = nf({ style: "currency", currency: "USD", maximumFractionDigits: 0 });
const money = (n: number) => usd.format(Math.round(n));

/** The target revenue slider: $2,500 to $250,000 a month in three years, on a log scale. */
const SLIDER = { min: 2_500, max: 250_000, initial: 25_000 };
const MONTHS = 36;
const pos = (v: number) => Math.log(v / SLIDER.min) / Math.log(SLIDER.max / SLIDER.min);

/** Steady growth from zero to `target` over three years: the running totals, month by month. */
function project(target: number) {
  let fee = 0;
  let servers = 0;
  const feeLine: number[] = [];
  const serverLine: number[] = [];
  for (let m = 1; m <= MONTHS; m++) {
    const revenue = (target * m) / MONTHS;
    fee += revenueCatCost(revenue);
    servers += openpurrCost(revenue).cost;
    feeLine.push(fee);
    serverLine.push(servers);
  }
  return { fee, servers, after: revenueCatCost(target) * 12, feeLine, serverLine };
}
/** The chart's two lines as SVG paths, scaled to the revenue share's total. */
const W = 600;
const H = 180;
function paths(pr: ReturnType<typeof project>) {
  const max = Math.max(pr.fee, 1);
  const pt = (v: number, i: number) => `${((i + 1) / MONTHS) * W},${H - (v / max) * (H - 8)}`;
  const line = (vs: number[]) => `M0,${H} ` + vs.map((v, i) => `L${pt(v, i)}`).join(" ");
  return { fee: line(pr.feeLine), feeArea: `${line(pr.feeLine)} L${W},${H} Z`, servers: line(pr.serverLine) };
}
const initial = project(SLIDER.initial);
const initialPaths = paths(initial);

const homePath = localePath(locale, "/");
const pagePath = localePath(locale, START_PAGE);
const site = Astro.site!.href.replace(/\/$/, "");
const pageUrl = `${site}${pagePath}`;
const startUrl = `${REPO_URL}#getting-started`;

const fi = c.faq.items;
const faq = [
  { q: fi.backend.q, a: fi.backend.a },
  { q: fi.cheapest.q, a: fill(fi.cheapest.a, { servers: money(openpurrCost(25_000).cost * 12), m25k: money(25_000) }) },
  { q: fi.free.q, a: fi.free.a },
  { q: fi.switch.q, a: fi.switch.a },
  { q: fi.missing.q, a: fi.missing.a },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      name: c.how.title,
      description: c.how.lede,
      inLanguage: tag,
      totalTime: "PT1H",
      estimatedCost: { "@type": "MonetaryAmount", currency: "USD", value: "0" },
      step: c.how.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.title, text: s.text.replace(/<[^>]+>/g, "") })),
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      inLanguage: tag,
      mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site}/#software`,
      name: "openpurr",
      url: `${site}/`,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Cloudflare Workers, Linux",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "openpurr", item: `${site}${homePath}` },
        { "@type": "ListItem", position: 2, name: c.hero.crumb, item: pageUrl },
      ],
    },
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const model = { slider: SLIDER, months: MONTHS, w: W, h: H, tag };

// The prompt for an AI coding assistant. It stays in English, which every assistant reads well, and
// asks for answers in the page's language.
const language = new Intl.DisplayNames(["en"], { type: "language" }).of(tag) ?? "English";
const prompt = `Help me add in-app purchases and subscriptions to this app with openpurr (https://github.com/openpurr/openpurr), an open-source, self-hosted backend that works with the official RevenueCat Purchases SDK. I don't need a RevenueCat account, and there's no revenue share.

1. Read openpurr's README, especially "Getting started" and "SDK compatibility".
2. Deploy openpurr Lite to my Cloudflare account (the free plan is enough): clone the repo, run \`npx pnpm install\`, then in lite/ run \`npx wrangler login\` and \`npx pnpm run setup\`. Stop and ask me before anything that needs my login or a payment.
3. Walk me through adding my app, products, entitlements and offerings in the openpurr dashboard, and setting up App Store Connect and the Google Play Console: store credentials and server notifications.
4. Add the Purchases SDK to this project. Use the SDK key and SDK Worker URL from the dashboard (Configuration → Apps and products has ready-to-paste setup code), set the proxy URL before calling configure, and leave entitlement verification at its default (disabled).
5. Add a simple paywall and an entitlement check, then help me test a sandbox purchase.
6. Run \`npx @openpurr/cli login\` and \`npx @openpurr/cli doctor\`, and fix anything it reports.

Explain each step briefly, and ask me before changing anything outside this project.${locale === "en" ? "" : ` Reply in ${language}.`}`;
/** The coding assistants whose logos sit on the copy buttons (src/agent-logos.json, from LobeHub's MIT icon set). */
const agents = Object.values(agentLogos);
const claudeCommands = "/plugin marketplace add openpurr/openpurr\n/plugin install openpurr@openpurr";
---

<Base
  locale={locale}
  alternates={allLocales(START_PAGE)}
  title={c.meta.title}
  description={c.meta.description}
  ogImage="/og-add-in-app-purchases.png"
  ogImageAlt={c.meta.ogImageAlt}
>
  <script type="application/ld+json" set:html={jsonLdText} />
  <article class="start" data-model={JSON.stringify(model)}>
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={homePath}>openpurr</a></li>
            <li aria-current="page">{c.hero.crumb}</li>
          </ol>
        </nav>
        <span class="eyebrow">{c.hero.eyebrow}</span>
        <h1>{c.hero.headline} <span class="accent">{c.hero.headlineAccent}</span></h1>
        <p class="lede">{fill(c.hero.lede, { threshold: money(RC.threshold) })}</p>
        <div class="cta">
          <a class="btn btn-primary" href={startUrl}>{c.hero.ctaStart}</a>
          <button class="agent-pill" type="button" data-copy data-copied={c.ai.copied}>
            <span class="logos" aria-hidden="true">{agents.map((a) => <span class="logo" title={a.name}><svg viewBox="0 0 24 24" fill="currentColor" fill-rule={a.evenodd ? "evenodd" : undefined} set:html={a.svg} /></span>)}</span>
            <span class="label">{c.hero.ctaAi}</span>
          </button>
          <a class="btn btn-ghost" href="#how">{c.hero.ctaHow}</a>
        </div>
      </div>
    </section>

    <section class="growth-section">
      <div class="wrap">
        <div class="card growth">
          <h2>{c.growth.title}</h2>
          <p class="muted">{c.growth.text}</p>
          <label class="rev" for="target">
            <span>{c.growth.target}</span>
            <output data-out="target">{money(SLIDER.initial)}</output>
          </label>
          <input id="target" type="range" min="0" max="1000" step="1" value={Math.round(1000 * pos(SLIDER.initial))} />

          <svg class="chart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={c.growth.chartLabel}>
            <path class="area" data-path="feeArea" d={initialPaths.feeArea} />
            <path class="fee-line" data-path="fee" d={initialPaths.fee} />
            <path class="server-line" data-path="servers" d={initialPaths.servers} />
          </svg>
          <div class="axis" aria-hidden="true"><span>0</span><span>12</span><span>24</span><span>36</span></div>

          <div class="totals">
            <div><span class="k">{c.growth.fee}</span><strong data-out="fee">{money(initial.fee)}</strong></div>
            <div><span class="k">{c.growth.servers}</span><strong class="ok" data-out="servers">{money(initial.servers)}</strong></div>
            <div><span class="k">{c.growth.after}</span><strong data-out="after">{money(initial.after)}</strong></div>
          </div>
          <p class="summary" set:html={fill(c.growth.summary, { fee: `<span data-out="fee2">${money(initial.fee)}</span>`, servers: `<span data-out="servers2">${money(initial.servers)}</span>` })} />
        </div>
      </div>
    </section>

    <section class="invest-section">
      <div class="wrap">
        <h2>{c.invest.title}</h2>
        <p class="muted">{c.invest.text}</p>
        <div class="invest-receipts"><Receipts locale={locale} /></div>
      </div>
    </section>

    <section id="how" class="alt">
      <div class="wrap">
        <h2>{c.how.title}</h2>
        <p class="muted">{c.how.lede}</p>
        <ol class="steps">
          {
            c.how.steps.map((s, i) => (
              <li>
                <span class="num">{i + 1}</span>
                <h3>{s.title}</h3>
                <p set:html={s.text} />
              </li>
            ))
          }
        </ol>
        <div class="code-grid">
          <div>
            <p class="code-label">{c.how.setupLabel}</p>
            <pre class="shell" dir="ltr"><code><span class="c"># Node 22.12 or later, and a Cloudflare account</span>
git clone https://github.com/openpurr/openpurr
cd openpurr && npx pnpm install
cd lite && npx wrangler login
npx pnpm run setup</code></pre>
          </div>
          <div><SdkSnippet locale={locale} /></div>
        </div>
      </div>
    </section>

    <section id="ai" class="ai-section">
      <div class="wrap">
        <div class="ai card">
          <h2>{c.ai.title}</h2>
          <p class="muted">{c.ai.text}</p>
          <button class="agent-pill big" type="button" data-copy data-copied={c.ai.copied} aria-label={`${c.ai.copy}: ${agents.map((a) => a.name).join(", ")}`}>
            <span class="logos" aria-hidden="true">{agents.map((a) => <span class="logo" title={a.name}><svg viewBox="0 0 24 24" fill="currentColor" fill-rule={a.evenodd ? "evenodd" : undefined} set:html={a.svg} /></span>)}</span>
            <span class="label">{c.ai.copy}</span>
          </button>
          <pre class="prompt" dir="ltr" data-prompt>{prompt}</pre>
          <p class="claude-tip">{c.ai.claudeTip}</p>
          <pre class="shell small" dir="ltr"><code>{claudeCommands}</code></pre>
        </div>
      </div>
    </section>

    <section class="includes-section">
      <div class="wrap">
        <div class="narrow">
        <h2>{c.includes.title}</h2>
        <ul class="yes">
          {c.includes.yes.map((item) => <li>{item}</li>)}
        </ul>
        <p class="not-yet"><b>{c.includes.notYetTitle}:</b> {c.includes.notYet}</p>

        <h2>{c.lockin.title}</h2>
        <p>{c.lockin.text}</p>
        <p class="pricing-link">{c.pricingLink.text} <a href={localePath(locale, PRICING_PAGE)}>{c.pricingLink.link}</a></p>

        <h2>{c.faq.title}</h2>
        <div class="faq">
          {
            faq.map(({ q, a }) => (
              <details>
                <summary><h3>{q}</h3></summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>

        <div class="cta">
          <a class="btn btn-primary" href={startUrl}>{c.hero.ctaStart}</a>
        </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  import { openpurrCost, revenueCatCost } from "../savings";

  const root = document.querySelector<HTMLElement>(".start");
  if (root) {
    const model = JSON.parse(root.dataset.model!) as { slider: { min: number; max: number; initial: number }; months: number; w: number; h: number; tag: string };
    const usd = new Intl.NumberFormat(`${model.tag}-u-nu-latn`, { style: "currency", currency: "USD", maximumFractionDigits: 0 });
    const input = root.querySelector<HTMLInputElement>("#target")!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const path = (k: string) => root.querySelector<SVGPathElement>(`[data-path="${k}"]`)!;
    const valueAt = (p: number) => {
      const v = model.slider.min * Math.pow(model.slider.max / model.slider.min, p / 1000);
      const step = v < 10_000 ? 500 : v < 100_000 ? 1_000 : 5_000;
      return Math.round(v / step) * step;
    };
    const render = (target: number) => {
      let fee = 0;
      let servers = 0;
      const feeLine: number[] = [];
      const serverLine: number[] = [];
      for (let m = 1; m <= model.months; m++) {
        const revenue = (target * m) / model.months;
        fee += revenueCatCost(revenue);
        servers += openpurrCost(revenue).cost;
        feeLine.push(fee);
        serverLine.push(servers);
      }
      const max = Math.max(fee, 1);
      const pt = (v: number, i: number) => `${((i + 1) / model.months) * model.w},${model.h - (v / max) * (model.h - 8)}`;
      const line = (vs: number[]) => `M0,${model.h} ` + vs.map((v, i) => `L${pt(v, i)}`).join(" ");
      path("fee").setAttribute("d", line(feeLine));
      path("feeArea").setAttribute("d", `${line(feeLine)} L${model.w},${model.h} Z`);
      path("servers").setAttribute("d", line(serverLine));
      out("target").textContent = usd.format(target);
      for (const [k, v] of [["fee", fee], ["fee2", fee], ["servers", servers], ["servers2", servers], ["after", revenueCatCost(target) * 12]] as const) {
        out(k).textContent = usd.format(Math.round(v));
      }
    };
    input.addEventListener("input", () => render(valueAt(Number(input.value))));

    // Copy the AI prompt.
    const promptEl = root.querySelector<HTMLElement>("[data-prompt]");
    for (const copy of root.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      if (!promptEl) break;
      const labelEl = copy.querySelector<HTMLElement>(".label")!;
      const label = labelEl.textContent;
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(promptEl.textContent ?? "");
        } catch {
          const range = document.createRange();
          range.selectNodeContents(promptEl);
          getSelection()?.removeAllRanges();
          getSelection()?.addRange(range);
          document.execCommand("copy");
        }
        labelEl.textContent = copy.dataset.copied ?? label;
        copy.classList.add("done");
        setTimeout(() => {
          labelEl.textContent = label;
          copy.classList.remove("done");
        }, 2000);
      });
    }

    // Draw the chart in once it scrolls into view.
    const chart = root.querySelector<SVGElement>(".chart")!;
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      chart.classList.add("waiting");
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        chart.classList.remove("waiting");
      }, { threshold: 0.4 });
      io.observe(chart);
    }
  }
</script>

<style>
  .hero {
    padding-bottom: 32px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: "/";
    margin-inline-end: 6px;
    opacity: 0.6;
  }
  .crumbs a {
    color: inherit;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 820px;
    margin-bottom: 18px;
  }
  .accent {
    display: block;
    color: var(--purple);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .growth-section {
    padding-top: 0;
  }
  .growth {
    max-width: 860px;
    padding: 32px;
  }
  .growth h2,
  .invest-section h2,
  #how h2,
  .narrow h2 {
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .muted {
    color: var(--muted);
  }
  .rev {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 22px;
    font-weight: 600;
    color: var(--muted);
  }
  .rev output {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: 100%;
    margin: 14px 0 22px;
    accent-color: var(--purple);
  }
  .chart {
    width: 100%;
    height: 180px;
    display: block;
    overflow: visible;
  }
  .chart .area {
    fill: color-mix(in srgb, var(--purple) 14%, transparent);
    transition: opacity 0.6s ease;
  }
  .chart .fee-line {
    fill: none;
    stroke: var(--purple);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 2000;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .chart .server-line {
    fill: none;
    stroke: var(--ok);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
  .chart.waiting .fee-line {
    stroke-dashoffset: 2000;
  }
  .chart.waiting .area {
    opacity: 0;
  }
  .axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .totals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 22px;
  }
  .totals .k {
    display: block;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .totals strong {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .totals strong.ok {
    color: var(--ok);
  }
  .summary {
    margin-top: 18px;
    color: var(--text);
  }
  .summary :global(b) {
    color: var(--ink);
  }
  .invest-section {
    padding-top: 24px;
  }
  .invest-receipts {
    max-width: 860px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .steps li {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
  }
  .steps .num {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--purple);
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
  }
  .steps h3 {
    margin: 12px 0 6px;
    font-size: 1.05rem;
  }
  .steps p {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .code-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
    align-items: start;
  }
  .code-grid > div {
    min-width: 0;
  }
  .code-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .shell {
    margin: 0;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: #17142a;
    color: #e9e6f5;
    font-size: 0.85rem;
    line-height: 1.7;
    overflow-x: auto;
  }
  .shell .c {
    color: #8f88ad;
  }
  .ai-section {
    padding-top: 0;
  }
  #how + .ai-section {
    padding-top: 64px;
  }
  .ai {
    max-width: 860px;
    padding: 32px;
  }
  .ai h2 {
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .agent-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 18px 8px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .agent-pill:hover {
    border-color: var(--purple);
    box-shadow: 0 8px 20px -12px rgba(60, 40, 140, 0.45);
    transform: translateY(-1px);
  }
  .agent-pill.done {
    border-color: var(--ok);
  }
  .agent-pill.big {
    margin-top: 18px;
    padding: 10px 22px 10px 12px;
    font-size: 1.05rem;
  }
  .logos {
    display: inline-flex;
  }
  .logo {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--card);
    box-shadow: 0 0 0 1px var(--line);
    color: #111;
  }
  .logo + .logo {
    margin-inline-start: -8px;
  }
  .logo svg {
    width: 18px;
