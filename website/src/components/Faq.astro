---
// One list feeds both the visible FAQ and the FAQPage structured data, so they can't drift. The
// questions are in src/i18n/.
import { MIGRATION_URL } from "../consts";
import { DEFAULT_LOCALE, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const copy = t(locale).faq;
const faqs = copy.items;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: locale,
  mainEntity: faqs.map(({ q, a, link }) => ({
    "@type": "Question",
    name: q,
    // Google allows links in an answer's text.
    acceptedAnswer: { "@type": "Answer", text: link ? `${a} <a href="${MIGRATION_URL}">${link}</a>` : a },
  })),
};
// Escape "<" so answer text can never close the script element.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<section class="alt" id="faq">
  <div class="wrap faq-grid">
    <div class="section-head">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2>{copy.title}</h2>
      <p class="lede">{copy.lede}</p>
    </div>
    <div class="list">
      {
        faqs.map(({ q, a, link }) => (
          <details>
            <summary>
              <h3>{q}</h3>
            </summary>
            <p>
              {a}
              {link && (
                <>
                  {" "}
                  <a href={MIGRATION_URL}>{link} →</a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={jsonLdText} />
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
  .list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    flex: none;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--purple);
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  summary h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  summary:hover h3 {
    color: var(--purple);
  }
  details p {
    margin: 0 0 22px;
    color: var(--muted);
    max-width: 680px;
  }
  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
</style>
