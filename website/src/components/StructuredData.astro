---
// What openpurr is, for search engines and AI assistants: the software (SoftwareApplication) and
// the project behind it (Organization). The FAQ's FAQPage data lives in Faq.astro.
import { RELEASE, REPO_URL, LICENSE_URL } from "../consts";
import { DEFAULT_LOCALE, langTag, localePath, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const copy = t(locale).structured;

const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "openpurr",
      url: `${site}/`,
      logo: `${site}/icon-192.png`,
      sameAs: [REPO_URL],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site}/#software`,
      name: "openpurr",
      description: copy.description,
      url: `${site}${localePath(locale, "/")}`,
      inLanguage: langTag(locale),
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: copy.subCategory,
      operatingSystem: "Cloudflare Workers",
      softwareVersion: RELEASE.version,
      datePublished: RELEASE.date,
      license: LICENSE_URL,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      downloadUrl: REPO_URL,
      screenshot: `${site}/dashboard.png`,
      featureList: copy.features,
      publisher: { "@id": `${site}/#organization` },
    },
  ],
};
// Escape "<" so no text can close the script element.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<script is:inline type="application/ld+json" set:html={jsonLdText} />
