---
import { REPO_URL, ROADMAP_URL, CONTRIBUTING_URL, LICENSE_URL, SPONSOR_URL, PRIVACY_URL } from "../consts";
import { gaId } from "../analytics";
import { DEFAULT_LOCALE, fill, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const f = t(locale).footer;
---

<footer>
  <div class="wrap">
    <div class="top">
      <div>
        <img src="/mark.png" alt="" width="40" height="40" />
        <p class="tag">{f.tagline}</p>
      </div>
      <ul>
        <li><a href={REPO_URL}>GitHub</a></li>
        <li><a href={ROADMAP_URL}>{f.roadmap}</a></li>
        <li><a href={CONTRIBUTING_URL}>{f.contributing}</a></li>
        <li><a href={SPONSOR_URL}>{f.sponsor}</a></li>
        <li><a href={PRIVACY_URL}>{f.privacy}</a></li>
      </ul>
    </div>
    <p class="fine">{f.disclaimer}</p>
    <p class="fine">
      <a href={LICENSE_URL}>Apache License 2.0</a>. {fill(f.copyright, { year: String(new Date().getFullYear()) })}
      {gaId && <button type="button" class="settings" data-cookie-settings hidden>{f.cookieSettings}</button>}
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 48px 0 40px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .tag {
    margin: 10px 0 0;
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0;
    padding: 0;
  }
  ul a {
    color: var(--text);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--purple);
  }
  .fine {
    margin: 0 0 6px;
    font-size: 0.85rem;
  }
  .fine a {
    color: inherit;
  }
  .settings {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    margin-left: 6px;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
