---
import { MIGRATION_PAGE, REPO_URL } from "../consts";
import { DEFAULT_LOCALE, LOCALE_INFO, langTag, localePath, t, type Alternates, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
  alternates?: Alternates;
}
const { locale = DEFAULT_LOCALE, alternates = {} } = Astro.props;
const h = t(locale).header;
const home = localePath(locale, "/");
const languages = Object.entries(alternates) as [Locale, string][];
---

<header class="site-header">
  <div class="wrap bar">
    <a href={home} class="brand" aria-label={h.home}>
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="/logo-dark.png" />
        <img src="/logo.png" alt="openpurr" width="136" height="40" />
      </picture>
    </a>
    <nav aria-label="Main">
      <a href={`${home}#features`} class="hide-sm">{h.nav.features}</a>
      <a href={`${home}#editions`} class="hide-sm">{h.nav.editions}</a>
      <a href={`${home}#roadmap`} class="hide-sm">{h.nav.roadmap}</a>
      <a href={`${home}#faq`} class="hide-sm">{h.nav.faq}</a>
      <a href={localePath(locale, MIGRATION_PAGE)} class="hide-sm" aria-current={Astro.url.pathname === localePath(locale, MIGRATION_PAGE) ? "page" : undefined}>{h.nav.migrate}</a>
      {
        languages.length > 1 && (
          <details class="lang">
            <summary aria-label={`${h.language}: ${LOCALE_INFO[locale].name}`}>
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
              </svg>
              {LOCALE_INFO[locale].short}
            </summary>
            <ul>
              {languages.map(([l, path]) => (
                <li>
                  <a href={path} hreflang={langTag(l)} lang={langTag(l)} aria-current={l === locale ? "true" : undefined}>
                    {LOCALE_INFO[l].name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <a href={REPO_URL} class="gh">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand img {
    height: 40px;
    width: auto;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  nav a {
    white-space: nowrap;
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--purple);
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 9px;
  }
  .lang {
    position: relative;
  }
  .lang summary {
    list-style: none;
    /* flex, not inline-flex: inline content inside <details> gets a line box whose descender
       space pushes the label above the other links. */
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang summary:hover {
    color: var(--purple);
  }
  .lang ul {
    position: absolute;
    inset-inline-end: 0;
    max-height: min(70vh, 560px);
    overflow-y: auto;
    top: calc(100% + 10px);
    list-style: none;
    margin: 0;
    padding: 6px;
    min-width: 140px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 12px 32px -12px rgb(20 16 40 / 0.3);
  }
  .lang ul a {
    display: block;
    padding: 7px 10px;
    border-radius: 6px;
  }
  .lang ul a:hover {
    background: var(--bg-alt);
  }
  .lang ul a[aria-current] {
    color: var(--purple);
    font-weight: 600;
  }
  @media (max-width: 1000px) {
    nav {
      gap: 20px;
    }
  }
  /* Below this, the section links don't fit next to the logo in every language. */
  @media (max-width: 860px) {
    .hide-sm {
      display: none;
    }
  }
</style>

<script>
  // <details> only closes from its own summary. Close the language menu like any other menu too:
  // on a click or tap outside it, on Escape (focus goes back to the button), and when keyboard
  // focus moves out of it.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("details.lang")) {
    const close = () => menu.removeAttribute("open");
    document.addEventListener("pointerdown", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !menu.open) return;
      close();
      menu.querySelector("summary")?.focus();
    });
    menu.addEventListener("focusout", (e) => {
      if (menu.open && e.relatedTarget && !menu.contains(e.relatedTarget as Node)) close();
    });
  }
</script>
