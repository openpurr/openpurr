---
// Google Tag Manager (or a GA4 tag), only with the visitor's consent. Nothing is loaded from
// Google, and no cookie is set, until they accept in the banner (Consent Mode's "basic" setup).
// Consent is granted for analytics before the container loads, so its tags can rely on it; ad
// signals stay denied (the site has no ads). The choice is kept in localStorage; "Cookie
// settings" in the footer opens the banner again.
import { googleTag } from "../analytics";
---

{
  googleTag && (
    <>
      <div id="consent" class="consent" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
        <p>
          We'd like to use Google Analytics cookies to count visits and see which pages help. Nothing is set unless you
          accept, and you can change your mind any time under Cookie settings. <a href="/privacy/">Privacy</a>
        </p>
        <div class="consent-actions">
          <button type="button" class="consent-btn" data-consent="denied">Decline</button>
          <button type="button" class="consent-btn primary" data-consent="granted">Accept</button>
        </div>
      </div>
      <script is:inline define:vars={{ id: googleTag }}>
        (() => {
          const KEY = "openpurr_analytics_consent";
          const read = () => {
            try {
              return localStorage.getItem(KEY);
            } catch {
              return null;
            }
          };
          const write = (v) => {
            try {
              localStorage.setItem(KEY, v);
            } catch {}
          };
          let loaded = false;
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("consent", "default", { analytics_storage: "denied", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied" });
          const load = () => {
            if (loaded) return;
            loaded = true;
            gtag("consent", "update", { analytics_storage: "granted" });
            gtag("js", new Date());
            const gtm = id.startsWith("GTM-");
            // A GA4 tag is configured here; a Tag Manager container configures its own tags.
            if (gtm) dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
            else gtag("config", id);
            const s = document.createElement("script");
            s.async = true;
            s.src = `https://www.googletagmanager.com/${gtm ? "gtm.js" : "gtag/js"}?id=${id}`;
            document.head.append(s);
          };
          // Declining after accepting: stop tracking and remove the cookies GA set on this domain.
          const unload = () => {
            gtag("consent", "update", { analytics_storage: "denied" });
            if (!id.startsWith("GTM-")) window[`ga-disable-${id}`] = true;
            for (const c of document.cookie.split(";")) {
              const name = c.split("=")[0].trim();
              if (name === "_ga" || name.startsWith("_ga_")) {
                for (const domain of ["", `; domain=${location.hostname}`, `; domain=.${location.hostname.replace(/^www\./, "")}`]) {
                  document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domain}`;
                }
              }
            }
          };
          const banner = () => document.getElementById("consent");
          const choose = (v) => {
            write(v);
            banner().hidden = true;
            if (v === "granted") load();
            else unload();
          };
          const start = () => {
            const b = banner();
            b.addEventListener("click", (e) => {
              const v = e.target.closest("[data-consent]")?.dataset.consent;
              if (v) choose(v);
            });
            document.querySelectorAll("[data-cookie-settings]").forEach((el) => {
              el.hidden = false;
              el.addEventListener("click", () => {
                b.hidden = false;
                b.querySelector(".primary").focus();
              });
            });
            if (!read()) b.hidden = false;
          };
          if (read() === "granted") load();
          if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
          else start();
        })();
      </script>
    </>
  )
}

<style is:global>
  .consent {
    position: fixed;
    z-index: 50;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 560px;
    margin: 0 auto;
    padding: 16px 18px;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px -16px rgb(20 16 40 / 0.35);
    font-size: 0.92rem;
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    margin: 0 0 12px;
  }
  .consent p a {
    color: var(--purple);
  }
  .consent-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .consent-btn {
    font: inherit;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .consent-btn.primary {
    background: var(--purple);
    border-color: var(--purple);
    color: #fff;
  }
  .consent-btn:hover {
    border-color: var(--purple);
  }
  .consent-btn.primary:hover {
    background: var(--purple-strong);
  }
</style>
