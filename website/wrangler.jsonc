// openpurr marketing site: static assets only (no Worker script), free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpurr-website",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The openpurr.org zone must be in the same Cloudflare account; deploy creates the DNS records
  // and certificates for both hostnames. www.openpurr.org is the main address (pages declare it as
  // canonical). The apex stays attached so it resolves, and a Cloudflare Redirect Rule on the zone
  // sends it to www with a 301; the rule runs before the site is served.
  "routes": [
    { "pattern": "openpurr.org", "custom_domain": true },
    { "pattern": "www.openpurr.org", "custom_domain": true }
  ]
}
