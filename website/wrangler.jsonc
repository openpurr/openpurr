// openpurr marketing site: static assets only (no Worker script), free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpurr-website",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The openpurr.org zone must be in the same Cloudflare account; deploy creates the DNS record.
  "routes": [{ "pattern": "openpurr.org", "custom_domain": true }]
}
