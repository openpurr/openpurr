// openpurr Lite edition, M0 spike configuration.
// Everything here must work on the Cloudflare free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpurr",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Smaller bundle, faster isolate startup (see scripts/check-bundle.mjs). Stack traces in
  // Workers Logs stay readable through the uploaded source map.
  "minify": true,
  "upload_source_maps": true,

  // Compiles openpurr.config.yaml into src/config.generated.json before every deploy and dev run.
  // A config mistake fails here with a message saying what's wrong.
  "build": { "command": "node scripts/build-config.mjs" },

  // Workers Logs records CPU time per invocation; M0 reads benchmark results from it.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openpurr",
      "database_id": "378b4252-db50-4e7a-97b4-ee66ea86fbe1",
      "migrations_dir": "migrations"
    }
  ],

  // The Rate Limiting binding works on the free plan (confirmed 2026-11-18).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],

  "vars": {
    // "on" stores every SDK request in the D1 `capture` table (spike only).
    "CAPTURE": "on"
  },

  // Public SDK keys live in openpurr.config.yaml (they ship inside apps, so they aren't secrets).
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally):
  //   BENCH_TOKEN   bearer token for the /__capture endpoint (and /__bench on the bench Worker)

  "env": {
    // Benchmark Worker: the same app plus /__bench and test-only keys, deployed separately as
    // `openpurr-bench` so none of it ships in production. `pnpm deploy:bench`.
    // Bindings don't inherit between environments, so they're repeated here.
    "bench": {
      "main": "src/bench/worker.ts",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openpurr",
          "database_id": "378b4252-db50-4e7a-97b4-ee66ea86fbe1",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 100, "period": 60 }
        }
      ],
      "vars": { "CAPTURE": "off" }
    }
  }
}
