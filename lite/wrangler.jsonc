// openpurr Lite edition. Everything here must work on the Cloudflare free plan.
//
// Two Workers share one D1 database:
//   - openpurr (top level): the SDK API (/v1) only, kept small for fast cold starts;
//   - openpurr-office (env "office"): store notifications, the scheduled jobs and the admin side.
// Deploy both: pnpm run deploy && pnpm deploy:office. Store credentials (APPLE_IAP_KEY,
// GOOGLE_SERVICE_ACCOUNT, webhook secrets) are needed by both, so set each secret on both Workers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpurr",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Smaller bundle, faster isolate startup (see scripts/check-bundle.mjs). Stack traces in
  // Workers Logs stay readable through the uploaded source map.
  "minify": true,
  "upload_source_maps": true,

  // Bundles openpurr.config.yaml, if there is one, for a new deployment's first config import
  // (scripts/build-config.mjs). The config itself lives in D1 and is edited in the dashboard.
  "build": { "command": "node scripts/build-config.mjs" },

  // Workers Logs records CPU time per invocation; M0 reads benchmark results from it.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // The database is found by name when you deploy, and created on the first deploy if it doesn't
  // exist yet, so no database_id is needed. To pin a database by ID or use another name, set
  // OPENPURR_D1_DATABASE_ID / OPENPURR_D1_DATABASE_NAME for scripts/deploy-config.mjs instead of
  // editing this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openpurr",
      "migrations_dir": "migrations"
    }
  ],

  // Rate limits for the SDK endpoints (the binding works on the free plan). Counted per
  // Cloudflare location; periods can be 10 or 60 seconds. Tune them here.
  //   RATE_LIMIT_IP    per client IP. Generous, because carrier NAT puts many phones behind
  //                    one IP; an SDK session makes about 5 requests.
  //   RATE_LIMIT_USER  per app user ID, so one runaway client can't use the app's budget.
  // Over the limit, SDK calls get 429, except /receipts, which gets 503 so the purchase stays
  // queued on the device.
  "ratelimits": [
    { "name": "RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RATE_LIMIT_USER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],

  // The SDK Worker runs no scheduled jobs; the back-office Worker does (env "office" below).
  "triggers": { "crons": [] },

  "vars": {
    // "on" stores every SDK request in the D1 `capture` table (spike tooling, off in production;
    // the tests turn it on in vitest.config.ts).
    "CAPTURE": "off"
  },

  // Public SDK keys live in the config (they ship inside apps, so they aren't secrets).
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally):
  //   BENCH_TOKEN   bearer token for the /__capture endpoint (and /__bench on the bench Worker)

  "env": {
    // Back-office Worker: store notifications, scheduled jobs, admin. `pnpm deploy:office`.
    // Point App Store Server Notifications and Google's Pub/Sub push subscription at this Worker.
    "office": {
      "main": "src/office/index.ts",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openpurr",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT_IP", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } },
        { "name": "RATE_LIMIT_USER", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": { "CAPTURE": "off" },
      // The dashboard: plain HTML, CSS and JavaScript in office-ui/ (no build step), served as
      // static assets at /admin. Static asset requests are free and don't run the Worker. The admin
      // API, the MCP server (/mcp) and its OAuth endpoints, and store notifications always reach the Worker; any other page path gets index.html
      // and the dashboard routes it in the browser.
      "assets": {
        "directory": "office-ui",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/admin/v1/*", "/notifications/*", "/__capture", "/mcp", "/.well-known/*", "/oauth/*"]
      },
      // The scheduled job (src/scheduled.ts): storage cleanup and exchange rates hourly, webhook
      // retries and snapshot backfill every 5 minutes. One of the free plan's 5 Cron Triggers.
      "triggers": { "crons": ["*/5 * * * *"] }
    },
    // Benchmark Worker: the same app plus /__bench and test-only keys, deployed separately as
    // `openpurr-bench` so none of it ships in production. `pnpm deploy:bench`.
    // Bindings don't inherit between environments, so they're repeated here.
    "bench": {
      "main": "src/bench/worker.ts",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openpurr",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT_IP", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
        { "name": "RATE_LIMIT_USER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": { "CAPTURE": "off" },
      // The bench Worker shares the production database; only production runs the scheduled job.
      "triggers": { "crons": [] }
    }
  }
}
