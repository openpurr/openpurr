{
  "name": "@openpurr/conformance",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Language-neutral HTTP conformance suite for openpurr servers (Lite and Standard).",
  "scripts": {
    "fixtures": "node scripts/gen-fixtures.mjs",
    "test": "node scripts/gen-fixtures.mjs --if-missing && node scripts/run.mjs",
    "test:lite": "node scripts/gen-fixtures.mjs --if-missing && node scripts/run-lite.mjs",
    "typecheck": "node scripts/gen-fixtures.mjs --if-missing && tsc --noEmit"
  },
  "devDependencies": {
    "@peculiar/x509": "3.1.0",
    "@types/node": "24.19.2",
    "jose": "6.2.17",
    "reflect-metadata": "0.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
