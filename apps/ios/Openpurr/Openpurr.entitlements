<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign-in returns to https://<deployment>/app/oauth-callback. iOS hands that link to this app
	     only for domains listed here, and only once the deployment's apple-app-site-association
	     names this app (the ios_app_id setting). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(OPENPURR_DEPLOYMENT_HOST)</string>
		<string>webcredentials:$(OPENPURR_DEPLOYMENT_HOST)</string>
	</array>
</dict>
</plist>
